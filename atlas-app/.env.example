# Copy to .env.local and fill in. See ../README.md for what's real vs. what
# needs real credentials before this ships anywhere.

# SQLite for local dev — swap for a real Postgres connection string in
# production (see README "Postgres" section for the two-line change needed).
DATABASE_URL="file:./dev.db"

# Any random 32+ byte string for local dev. Generate a real one for
# production with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-real-random-secret"

NEXTAUTH_URL="http://localhost:3000"
