# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite dev database — never commit real or seeded data
# (DATABASE_URL="file:./dev.db" resolves relative to the CWD a command is
# run from, which in practice has been repo-root-of-atlas-app, not prisma/ —
# both locations excluded so this can't slip through either way)
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal
